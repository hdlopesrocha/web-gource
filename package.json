{
  "name": "web-gource",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web-based, WebGL-powered Gource-inspired visualization of Git repository history.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --config vitest.api.config.ts"
  },
  "dependencies": {
    "three": "^0.180.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
